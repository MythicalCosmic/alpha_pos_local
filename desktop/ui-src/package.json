{
  "name": "alpha-pos-control-panel",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Alpha POS desktop control panel (Preact + Vite). Build output is committed to ../ui.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-manifest.mjs && node scripts/check-budgets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --port 4173 --strictPort",
    "budgets": "node scripts/check-budgets.mjs",
    "manifest": "node scripts/write-manifest.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.13.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
