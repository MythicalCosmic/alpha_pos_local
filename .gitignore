# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtualenvs
.venv/
.venv-build/
venv/
env/

# Desktop build artifacts
/build/
# Opt-in private installer plaintext exists only while Inno Setup is compiling.
/build/private-release/
/dist/
/installer/Output/
*.exe
*.spec.bak

# TUF self-update — NEVER commit signing keys or the published repo
/update_keys/
/update_repo/
.tufup-repo-config

# Desktop runtime
desktop/edge-profile/
desktop/admin_credentials.json
db.sqlite3
*.log
/staticfiles/
/media/
/order_audit/
/local_telegram_audit/
/DELIVERABLES/*Support-Config.json

# Secrets
.env
*.pem
.secret_key
.license_fernet_key
.device_id
.legacy_env_migrated
.legacy_pgdata_migrated

# Embedded Postgres data (local PG lives under %LOCALAPPDATA% at runtime, but ignore any here)
/pgdata/

# Tests / tooling
.pytest_cache/
.coverage

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Desktop panel per-install API token (generated)
.control_token
