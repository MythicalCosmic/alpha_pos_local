{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha POS",
  "mainBinaryName": "AlphaPOS",
  "version": "1.1.0",
  "identifier": "uz.alphapos.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Alpha POS",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../installer/hooks.nsh",
        "displayLanguageSelector": false,
        "startMenuFolder": "Alpha POS"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMEMwN0ZDNzg2RUYyRjQKUldUMDhtNTQvQWNNb3BTRUFHQWpULzh1bUY5Z0RPdHdZOWFQelUrTmpVQkx1TENscW82OWE5VVEK",
      "endpoints": [
        "https://control.78.111.91.113.nip.io/updates/tauri/stable/latest.json"
      ]
    }
  }
}
